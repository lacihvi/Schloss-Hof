	<!-- Nastavenie úvodného obrázka (Intro Image)
<layer name="introimage" 
       url="skin/intro3.png" 
	   scale="0.4"
       keep="true" 
       align="center" 
       width="prop" 
       height="100%" 
       zorder="100"
       enabled="true"
       visible="true"
       onclick="intro_start();"
       />

	    -->
	<action name="intro_start">
    <!-- 1. Fullscreen a zapnutie rotácie -->
    set(fullscreen, true);
    set(autorotate.enabled, true);
    set(autorotate.speed, -6.0); 
	

    <!-- 2. Zmena smeru po 10 sekundách (z 6.0 na -6.0) -->
    delayedcall(change_dir_timer, 10.0, 
        tween(autorotate.speed, 3.0, 2.0); 
    );

    <!-- 3. Odstránenie úvodného obrázka 
    tween(layer[introimage].alpha, 0.0, 0.5, default, 
        set(layer[introimage].visible, false);
        removelayer(introimage);
    ); -->
</action>
	
