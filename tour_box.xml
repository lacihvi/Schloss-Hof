<!-- ŠTARTOVACIA AKCIA: Spracuje parameter startscene z URL (či už pošlete číslo 12, 15 alebo text). Ak parameter chýba, načíta index 0 -->
<action name="startup" autoplay="true" autorun="onstart">
    if(startscene !== null,
        if(scene[get(startscene)] !== null,
            copy(target_start_scene, scene[get(startscene)].name);
        ,
            copy(target_start_scene, scene[get(startscene)].name);
        );
    ,
        copy(target_start_scene, scene[0].name);
    );
    loadscene(get(target_start_scene), null, MERGE);
</action>

<!-- Globálna udalosť: Kedykoľvek sa zmení scéna odkiaľkoľvek, posunie vizuálne aj položku v menu -->
<events name="cb_scene_sync" keep="true" 
        onnewpano="if(layer[cbscenes], layer[cbscenes].selectItemByName(get(xml.scene)); );" 
        />

<!-- ZMENA: Úplne sme vymazali 'onchange'. Menu už pri zrode nespustí žiadnu chybu null -->
<combobox name="cbscenes" 
          design="vtour" 
          align="leftbottom" 
          x="10" 
          y="10" 
          onloaded="add_scene_items();" 
          />

<!-- Táto akcia bezpečne naplní menu a akciu na kliknutie priradí priamo ku každému riadku zvlášť -->
<action name="add_scene_items" scope="local">
    for(set(i,0), i LT scene.count, inc(i), 
        <!-- Vytvoríme čistý text príkazu pre konkrétnu scénu -->
        set(click_action, calc('loadscene(' + scene[get(i)].name + ', null, MERGE);'));
        
        <!-- Pridáme položku pomocou addNamedItem, kde ID je meno scény a tretí parameter je akcia na kliknutie -->
        caller.addNamedItem(
            calc(scene[get(i)].name), 
            calc('[img src=[dq]' + scene[get(i)].thumburl + '[dq] style=[dq]border:1px solid rgba(255,255,255,0.5);width:48px;height:32px;vertical-align:middle;margin-right:8px;[dq]/] '+scene[get(i)].title),
            get(click_action)
        ); 
    );
    
    <!-- Vizuálne nastavíme označený riadok podľa aktuálne načítanej panorámy -->
    caller.selectItemByName(get(xml.scene));
</action>


